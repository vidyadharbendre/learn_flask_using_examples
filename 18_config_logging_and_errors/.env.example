# =============================================================================
# Day 18 — example environment file
# =============================================================================
# Copy to .env for local development:   cp .env.example .env
#
# .env is for DEVELOPMENT CONVENIENCE ONLY. It is gitignored, and production
# must use real environment variables injected by your platform or a secret
# manager (AWS Secrets Manager, Vault, Kubernetes Secrets, Doppler…).
#
# NEVER commit a .env containing real credentials. Committing .env.example —
# with placeholder values and comments — is good practice: it documents every
# variable the application needs.
# =============================================================================

APP_ENV=development
APP_DEBUG=true

# Generate one with:  flask --app wsgi.py new-secret
APP_SECRET_KEY=change-me-to-something-at-least-16-chars

APP_DATABASE_URL=sqlite:///instance/app.db

# text is readable in a terminal; json is queryable in a log aggregator.
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=text
# APP_LOG_FILE=logs/app.log

APP_SLOW_REQUEST_MS=500
APP_FEATURE_BETA_REPORTS=false
APP_ADMIN_EMAIL=ops@example.com
