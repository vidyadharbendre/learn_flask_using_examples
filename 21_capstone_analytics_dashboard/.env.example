# Day 21 — copy to .env for local development (.env is gitignored).
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-long-random-value
APP_DATABASE_URL=sqlite:///instance/analytics.db
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=text
APP_CACHE_TYPE=SimpleCache
APP_RATE_LIMIT_STORAGE=memory://
APP_RESPONSES_PER_MINUTE=20
APP_ITEMS_PER_PAGE=10
